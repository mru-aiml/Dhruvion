# DHRUVION Production Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Database
# SQLite (default) - file will be created in the data volume
DATABASE_URL=sqlite:///./data/dhruvion.db
# PostgreSQL (alternative) - uncomment and configure for production
# DATABASE_URL=postgresql://user:password@db:5432/dhruvion

# JWT Authentication
# IMPORTANT: Generate a strong random secret for production!
# Use: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=dhruvion_access_token

# CORS - Frontend origin(s) allowed to access the API
# Comma-separated list for multiple origins
FRONTEND_ORIGIN=http://localhost

# API Configuration
API_PREFIX=/api
API_TITLE=DHRUVION API
API_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO

# Data Paths
# NASA handover dataset directory (mount this volume in production)
DHRUVION_DATA_DIR=/app/data
# Static mount path for dataset files
DATASET_STATIC_MOUNT=/static/dhruvion

# Planning Assumptions
DEFAULT_TRAVEL_SPEED_M_PER_MIN=60.0

# =============================================================================
# AI ASSISTANT CONFIGURATION
# =============================================================================

# Enable/disable LLM integration
LLM_ENABLED=true

# Provider: "groq" (recommended) or "ollama" (local)
LLM_PROVIDER=groq

# Groq API Configuration (get key from https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# LLM Timeouts (seconds)
LLM_TIMEOUT_S=20.0
LLM_ANSWER_TIMEOUT_S=30.0
LLM_HEALTH_TIMEOUT_S=2.0

# LLM Behavior
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_TOKENS=100

# Ollama Configuration (local fallback)
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5-coder:3b

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API base URL for frontend (used at build time)
VITE_API_BASE_URL=http://localhost/api

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 1. Generate a strong JWT_SECRET_KEY: openssl rand -hex 32
# 2. Get a Groq API key from https://console.groq.com
# 3. Mount NASA data directory: -v /path/to/nasa/data:/app/data:ro
# 4. For PostgreSQL, add a db service and update DATABASE_URL
# 5. Set FRONTEND_ORIGIN to your production domain
# 6. Use a reverse proxy (nginx/traefik) for SSL termination in production