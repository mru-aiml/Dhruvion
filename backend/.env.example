# Database
DATABASE_URL=sqlite:///./dhruvion.db

# JWT Authentication (REQUIRED for production - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=dhruvion_access_token

# CORS - Frontend development origin
FRONTEND_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# AI assistant (Groq preferred, Ollama optional local fallback)
LLM_ENABLED=true
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_S=20
LLM_ANSWER_TIMEOUT_S=30
LLM_HEALTH_TIMEOUT_S=2
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_TOKENS=100

# Local fallback provider (used when LLM_PROVIDER is not "groq" or GROQ_API_KEY is empty)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5-coder:3b
